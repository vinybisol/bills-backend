<Project Sdk="Microsoft.NET.Sdk">

  <!-- NUnit/MTP/coverage settings are inherited from tests/Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>Api.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Respawn" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Api.IntegrationTests.Infrastructure" />
  </ItemGroup>

  <!-- Local-only test settings (git-ignored). CI supplies ConnectionStrings__Neon instead. -->
  <ItemGroup>
    <None Include="appsettings.Testing.Local.json"
          Condition="Exists('appsettings.Testing.Local.json')"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Api\Api.csproj" />
  </ItemGroup>

</Project>
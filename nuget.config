<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin package restore to nuget.org only. Required by Central Package Management
    (NU1507: multiple sources without package source mapping) and keeps restores
    reproducible regardless of machine-level feeds.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
